    "RedfishVersion": {
      "type": "string",
      "description": "Redfish protocol version supported"
    },
    "Systems": {
      "$ref": "#/components/schemas/ResourceLink"
    },
    "Chassis": {
      "$ref": "#/components/schemas/ResourceLink"
    },
    "Managers": {
      "$ref": "#/components/schemas/ResourceLink"
    },
    "AccountService": {
      "$ref": "#/components/schemas/ResourceLink"
    },
    "SessionService": {
      "$ref": "#/components/schemas/ResourceLink"
    },
    "UpdateService": {
      "$ref": "#/components/schemas/ResourceLink"
    },
    "EventService": {
      "$ref": "#/components/schemas/ResourceLink"
    },
    "TaskService": {
      "$ref": "#/components/schemas/ResourceLink"
    },
    "TelemetryService": {
      "$ref": "#/components/schemas/ResourceLink"
    }
  }
}