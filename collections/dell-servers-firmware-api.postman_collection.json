  "info": {
    "_postman_id": "55a87fc4-a827-452f-8b13-4f12f2f254b2",
    "name": "Dell Servers Dell iDRAC Redfish REST Accounts Firmware API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Integrated Dell Remote Access Controller (iDRAC) RESTful API built upon the DMTF Redfish standard for out-of-band server lifecycle management of Dell PowerEdge servers. Provides programmatic access to server inventory, health monitoring, configuration, firmware updates, power control, virtual media, and BIOS management through a standards-based REST interface.\n\nContact Support:\n Name: Dell Technologies Support",
      "type": "text/plain"
    }
  }
